{
  "expo": {
    "name": "AI Viral Clips",
    "slug": "ai-viral-clips",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aiviralclips.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aiviralclips.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 256
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      "expo-secure-store",
      "./plugins/with-cleartext-http"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28695dde-f73e-4f3e-a7ad-fa8c98a9b907"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28695dde-f73e-4f3e-a7ad-fa8c98a9b907"
    }
  }
}
