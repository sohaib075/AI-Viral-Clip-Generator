# Backend API port
PORT=5000

# Where the Python AI pipeline is running
PYTHON_API_URL=http://127.0.0.1:5001

# Public URL of this backend (used to build OAuth redirect URLs) and of the web frontend.
# To connect accounts from the mobile app, BASE_URL must be reachable from the phone (e.g. your PC's LAN IP).
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Optional access token. When set, every API request must send "Authorization: Bearer <token>";
# the web and mobile apps ask for it once. Media URLs may also use ?access_token=. Leave empty to
# only allow local browser origins. Generate one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=

# Extra browser origins allowed to call the API, comma-separated.
# Localhost origins are always allowed; add e.g. a deployed frontend or http://192.168.1.100:5173
ALLOWED_ORIGINS=
# Extra host names this server may be reached by, comma-separated (IP addresses and the hosts in
# BASE_URL, FRONTEND_URL and ALLOWED_ORIGINS are always allowed)
ALLOWED_HOSTS=

# Largest video upload accepted, in MB
MAX_UPLOAD_MB=2048

# How many past jobs to keep in data/jobs.json (oldest beyond this are dropped)
MAX_JOB_HISTORY=500

# Required to connect social accounts: 64 hex characters used to encrypt stored OAuth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable. If it changes, connected accounts must be reconnected.
ENCRYPTION_KEY=

# URL scheme of the mobile app, used to return to it after connecting an account
MOBILE_APP_SCHEME=mobileapp

# YouTube (Google Cloud OAuth client with the YouTube Data API enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional, defaults to ${BASE_URL}/auth/youtube/callback
YOUTUBE_REDIRECT_URI=
# public, unlisted or private (default public)
YOUTUBE_PRIVACY_STATUS=public

# X / Twitter (OAuth 2.0 client). Redirect URL: ${BASE_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok (Content Posting API with video.publish). Redirect URL: ${BASE_URL}/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: PUBLIC_TO_EVERYONE, FOLLOWER_OF_CREATOR, MUTUAL_FOLLOW_FRIENDS or SELF_ONLY.
# Empty = the most public level TikTok allows for the account.
TIKTOK_PRIVACY_LEVEL=

# Instagram (Meta app using the Instagram Graph API). Redirect URL: ${BASE_URL}/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Optional Graph API version, defaults to v23.0
META_GRAPH_VERSION=
