# API Keys for Cloud AI Pipeline

# Get your free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get your free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: how many jobs may run at the same time (each renders several clips in parallel). Default 2.
# MAX_CONCURRENT_JOBS=2

# Optional: set to 1 to allow downloading videos from hosts on your own network (blocked by default)
# ALLOW_PRIVATE_URLS=0

# Optional: interface to listen on. Defaults to 127.0.0.1 (Docker uses 0.0.0.0)
# FLASK_HOST=127.0.0.1

# Optional: set to 1 to enable Flask debug mode. Never enable it on a machine others can reach.
# FLASK_DEBUG=0
